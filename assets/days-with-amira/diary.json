{
  "version": 1,
  "title": {
    "en": "Days with Amira",
    "ar": "أيام مع أميرة"
  },
  "kicker": {
    "en": "A life between frames",
    "ar": "حياة بين الكادرات"
  },
  "lead": {
    "en": "Not everything makes it into the final cut.",
    "ar": "ليست كل اللحظات جزءًا من المشهد الأخير."
  },
  "intro": {
    "en": "Beyond the films, the photographs and the written words, there are moments that quietly shape the work. The people we meet, the places we find ourselves in, the conversations that stay with us, and the memories we carry into our next story. This is where those moments live.",
    "ar": "بعيدًا عن الأفلام والصور والكلمات، هناك لحظات صغيرة تشكّل ما نصنعه دون أن ننتبه. أشخاص نلتقي بهم، وأماكن نجد أنفسنا فيها، وأحاديث تظل معنا، وذكريات نحملها إلى حكايتنا القادمة. هنا تعيش تلك اللحظات."
  },
  "opening": "memory-28",
  "chapters": [
    {
      "id": "before-the-frame",
      "title": {
        "en": "Before the Frame",
        "ar": "قبل الكادر"
      },
      "reflection": {
        "en": "A little looking. A little listening. A place to begin.",
        "ar": "شيء من التأمل، وشيء من الإصغاء، وبداية لحكاية."
      }
    },
    {
      "id": "when-the-lights-go-down",
      "title": {
        "en": "When the Lights Go Down",
        "ar": "عندما تنطفئ الأضواء"
      },
      "reflection": {
        "en": "A screen, a room, and a moment shared.",
        "ar": "شاشة ومكان ولحظة نتقاسمها."
      }
    },
    {
      "id": "the-people-we-meet",
      "title": {
        "en": "The People We Meet",
        "ar": "أشخاص نلتقي بهم"
      },
      "reflection": {
        "en": "Some stories begin with a conversation.",
        "ar": "بعض الحكايات تبدأ بحديث."
      }
    },
    {
      "id": "somewhere-along-the-way",
      "title": {
        "en": "Somewhere Along the Way",
        "ar": "في مكان ما من الرحلة"
      },
      "reflection": {
        "en": "The spaces between one destination and the next.",
        "ar": "المسافات الصغيرة بين وجهة وأخرى."
      }
    },
    {
      "id": "the-little-things",
      "title": {
        "en": "The Little Things",
        "ar": "التفاصيل الصغيرة"
      },
      "reflection": {
        "en": "Small things. Still with us.",
        "ar": "تفاصيل صغيرة تبقى معنا."
      }
    }
  ],
